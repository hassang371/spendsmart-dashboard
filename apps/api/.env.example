# SCALE API Gateway — Environment Configuration
# Copy this file to .env and fill in your values.

# --- Supabase (Required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-key

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
# Production-only origins (overrides ALLOWED_ORIGINS when ENVIRONMENT=production)
PRODUCTION_ORIGINS=

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Setu Account Aggregator (Required for bank account linking) ---
# Get these from your Setu FIU dashboard: https://fiu.setu.co
# Use sandbox credentials for development (base URL defaults to sandbox automatically)
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
# Optional overrides (defaults shown):
# SETU_BASE_URL=https://fiu-sandbox.setu.co
# SETU_REDIRECT_URL=http://localhost:3000/dashboard/accounts/callback

# --- Sentry (Optional) ---
SENTRY_DSN=

# Sentry Observability
SENTRY_DSN=""

            "title": "Predicted Monthly Income",
            "type": "number"
          },
          "predicted_monthly_spend": {
            "title": "Predicted Monthly Spend",
            "type": "number"
          },
          "primary_drivers": {
            "items": {
              "$ref": "#/$defs/VariableImportance"
            },
            "title": "Primary Drivers",
            "type": "array"
          },
          "safe_to_spend": {
            "title": "Safe To Spend",
            "type": "number"
          }
        },
        "required": [
          "lowest_balance",
          "month_end",
          "predicted_monthly_spend",
          "predicted_monthly_income",
          "confidence_band_width",
          "primary_drivers",
          "safe_to_spend",
          "overdraft_risk_score",
          "floor_used",
          "floor_source"
        ],
        "title": "ForecastInsights",
        "type": "object"
      },
      "ForecastPoint": {
        "description": "One predicted day's full 7-quantile distribution.\n\nAll 7 quantiles are required floats. Both tiers (TFT-Hybrid and\nChronos-2) emit the same 7-quantile set; see RFC-003\n\u00a7\"Chronos-path quantile expansion\" for the engine upgrade that makes\nthis true.",
        "properties": {
          "date": {
            "title": "Date",
            "type": "string"
          },
          "p10": {
            "title": "P10",
            "type": "number"
          },
          "p2": {
            "title": "P2",
            "type": "number"
          },
          "p25": {
            "title": "P25",
            "type": "number"
          },
          "p50": {
            "title": "P50",
            "type": "number"
          },
          "p75": {
            "title": "P75",
            "type": "number"
          },
          "p90": {
            "title": "P90",
            "type": "number"
          },
          "p98": {
            "title": "P98",
            "type": "number"
          }
        },
        "required": ["date", "p2", "p10", "p25", "p50", "p75", "p90", "p98"],
        "title": "ForecastPoint",
        "type": "object"
      },
      "LowestBalance": {
        "description": "The horizon day where P10 is minimised, plus its P10/P50.",
        "properties": {
          "date": {
            "title": "Date",
            "type": "string"
          },
          "p10": {
            "title": "P10",
            "type": "number"
          },
          "p50": {
            "title": "P50",
            "type": "number"
          }
        },
        "required": ["date", "p10", "p50"],
        "title": "LowestBalance",
        "type": "object"
      },
      "QuantileSnapshot": {
        "description": "A point-in-time snapshot of the P10/P50/P90 distribution.",
        "properties": {
          "p10": {
            "title": "P10",
            "type": "number"
          },
          "p50": {
            "title": "P50",
            "type": "number"
          },
          "p90": {
            "title": "P90",
            "type": "number"
          }
        },
        "required": ["p10", "p50", "p90"],
        "title": "QuantileSnapshot",
        "type": "object"
      },
      "VariableImportance": {
        "description": "One ``(feature, weight)`` pair from the TFT Variable Selection Network.\n\nUsed both for the full ``ForecastResponse.variable_importance`` list\n(every feature the VSN reports) and for the top-3 subset surfaced in\n``ForecastInsights.primary_drivers``. Empty for Chronos-only forecasts.",
        "properties": {
          "feature": {
            "title": "Feature",
            "type": "string"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }

      "confidence": {
        "enum": ["low", "medium", "high"],
        "title": "Confidence",
        "type": "string"
      },
      "forecast": {
        "items": {
          "$ref": "#/$defs/ForecastPoint"
        },
        "maxItems": 30,
        "minItems": 1,
        "title": "Forecast",
        "type": "array"
      },
      "horizon": {
        "maximum": 30,
        "minimum": 1,
        "title": "Horizon",
        "type": "integer"
      },
      "insights": {
        "$ref": "#/$defs/ForecastInsights"
      },
      "model_type": {
        "enum": ["chronos2", "tft_hybrid", "ensemble"],

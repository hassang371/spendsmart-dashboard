        "type": "string"
      },
      "model_version": {
        "title": "Model Version",
        "type": "string"
      },
      "prediction_id": {
        "format": "uuid",
        "title": "Prediction Id",
        "type": "string"
      },
      "variable_importance": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/VariableImportance"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "title": "Variable Importance"
      }
    },
    "required": [
      "forecast",
      "model_type",
      "model_version",
      "horizon",
      "confidence",
      "variable_importance",
      "insights",
      "prediction_id"
    ],
    "title": "ForecastResponse",
    "type": "object"
  },
  "IntentCreateRequest": {
    "$defs": {
      "IntentConfidence": {
        "description": "Tiered confidence per LLD 010 \u00a7Design (Confidence interaction).",
        "enum": ["low", "medium", "high"],
        "title": "IntentConfidence",
        "type": "string"
      },
      "IntentType": {
        "description": "Seven intent types per LLD 010.",
        "enum": [
          "income_change",
          "planned_large_expense",
          "life_event",
          "obligation_change",
          "savings_goal",
          "fd_maturity",
          "expected_bonus"
        ],
        "title": "IntentType",
        "type": "string"
      }
    },
    "description": "POST /forecast/intents body.",
    "properties": {
      "amount": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Amount"
      },
      "amount_delta": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Amount Delta"
      },
      "category_bucket": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Category Bucket"
      },
      "confidence": {
        "$ref": "#/$defs/IntentConfidence",
        "default": "medium"
      },
      "end_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "End Date"
      },
      "intent_type": {
        "$ref": "#/$defs/IntentType"
      },
      "is_recurring": {
        "default": false,
        "title": "Is Recurring",
        "type": "boolean"
      },
      "notes": {
        "anyOf": [
          {
            "maxLength": 280,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Notes"
      },
      "rrule_freq": {
        "anyOf": [
          {
            "enum": ["monthly", "weekly", "biweekly", "quarterly", "annual"],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rrule Freq"
      },
      "start_date": {
        "format": "date",
        "title": "Start Date",
        "type": "string"
      }
    },
    "required": ["intent_type", "start_date"],
    "title": "IntentCreateRequest",
    "type": "object"
  },
  "IntentUpdateRequest": {

# ==============================================================================
# SCALE App — Root Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env files to version control.
# ==============================================================================

# --- Supabase (Required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-key

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed origins (for development)
ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated list of production origins (enforced when ENVIRONMENT=production)
PRODUCTION_ORIGINS=https://app.scale-app.com,https://api.scale-app.com

# --- Runtime Environment ---
# Options: development, staging, production
ENVIRONMENT=development

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- HuggingFace (Optional) ---
# Set to 1 after first run to prevent HF from making network calls on every startup.
# The model is cached locally in ~/.cache/huggingface after the first download.
TRANSFORMERS_OFFLINE=0

# --- Sentry (Optional — error tracking) ---
SENTRY_DSN=

# --- Flower Dashboard (Optional — Celery monitoring) ---
# Used with: docker compose --profile monitoring up
FLOWER_USER=admin
FLOWER_PASSWORD=changeme
